{
  // Cloudflare Workers static assets config for simplycybercon.org
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "simplycybercon",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Custom domains. Deploying attaches these to the worker and creates their
  // DNS records in the simplycybercon.org zone. Cut over from Carrd 2026-10-25.
  "routes": [
    { "pattern": "simplycybercon.org", "custom_domain": true },
    { "pattern": "www.simplycybercon.org", "custom_domain": true }
  ]
}
